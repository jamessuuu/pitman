# onnxruntime-web's own WASM runtime, copied from node_modules at
# dev/build time (scripts/copy-ort-assets.mjs) so it serves same-origin
# instead of onnxruntime-web's default jsdelivr CDN fetch. A large binary
# derived from node_modules, not source — never vendored into the repo.
/apps/web/public/ort/
